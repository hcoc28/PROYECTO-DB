.next/
out/
next-env.d.ts

# Producción
build/
dist/

# Variables de entorno (NUNCA subir credenciales)
.env
.env.local
.env.production

# Prisma
prisma/*.db

# Logs y temporales
*.log
.DS_Store
Thumbs.db

# ------------------------------------------------------------
# Seguridad: nunca subir secretos, llaves ni copias de la base de datos
# ------------------------------------------------------------
# Variantes de .env (la plantilla .env.example SI se sube)
.env.*
!.env.example

# Llaves y certificados
*.pem
*.key
*.pfx
*.p12
id_rsa*
id_ed25519*

